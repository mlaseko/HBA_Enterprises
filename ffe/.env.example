# Copy these into Replit Secrets (Tools > Secrets). Never commit real values.
APP_PASSWORD=choose-a-strong-password
SECRET_KEY=long-random-string-for-session-cookies
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require   # Neon connection string
STORAGE_BACKEND=replit            # replit | s3 | local
# Only for STORAGE_BACKEND=s3 (Cloudflare R2 / AWS S3):
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
APP_NAME=FF&E Studio
